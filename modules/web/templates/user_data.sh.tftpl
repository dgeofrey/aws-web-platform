#!/bin/bash
set -euo pipefail

WEB_ROOT=/usr/share/nginx/html

dnf install -y nginx

# IMDSv2: get a session token before reading instance metadata
TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/instance-id)
AZ=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/placement/availability-zone)

# Start from an empty web root so a failed deploy can't fall back to nginx's default page
rm -rf "$WEB_ROOT"/*

%{ if app_bucket != "" ~}
# Deploy build ${app_version} from S3. Retries cover IAM permissions that are still propagating.
for attempt in 1 2 3 4 5 6; do
  if aws s3 sync "s3://${app_bucket}/" "$WEB_ROOT/" --region "${region}" --only-show-errors; then
    break
  fi
  echo "S3 sync attempt $attempt failed, retrying in 10s"
  sleep 10
done

# Fail the boot (and so the health check) if the app didn't arrive
test -f "$WEB_ROOT/index.html"
%{ else ~}
cat > "$WEB_ROOT/index.html" <<HTML
<!doctype html>
<html>
  <head><title>${app_name}</title></head>
  <body>
    <h1>${app_name}</h1>
    <p>Served by $INSTANCE_ID in $AZ</p>
  </body>
</html>
HTML
%{ endif ~}

# Which instance, zone and build served the request (shown in the app footer)
cat > "$WEB_ROOT/instance.json" <<JSON
{"instance_id": "$INSTANCE_ID", "availability_zone": "$AZ", "app_version": "${app_version}"}
JSON

# Lightweight endpoint for load balancer health checks
echo "ok" > "$WEB_ROOT/health"

systemctl enable --now nginx
